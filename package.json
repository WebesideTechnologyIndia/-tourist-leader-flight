{
  "name": "touristleader.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd app_src && next dev -p 3000",
    "dev:local": "cd app_src && next dev -p 3000",
    "dev:https": "cd app_src && next dev --experimental-https -p 3001",
